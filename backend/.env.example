APP_NAME=IntelliMoney
ENVIRONMENT=development
VERSION=1.0.0
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=intellimoney
REDIS_URL=
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3002,http://localhost:8080,http://localhost:8000

# REQUIRED: Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANK_ENCRYPTION_KEY=2Fz0GyGP90qyAXzaweseHhlNxIMS7bcjEGdHP4Vh8-o=
BANK_CONSENT_REDIRECT_BASE=http://localhost:5173/connect-bank/consent

# REQUIRED: Clerk (the ONLY authentication provider)
# CLERK_FRONTEND_API is the app's Frontend API URL (e.g. <app>.clerk.accounts.dev)
# CLERK_PUBLISHABLE_KEY is the frontend publishable key (pk_test_... / pk_live_...)
CLERK_FRONTEND_API=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_AUTHORIZED_PARTIES=

# REQUIRED: Your Groq API key for AI Copilot features (get one at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=llama3-8b-8192
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=1024

# Setu Account Aggregator SANDBOX credentials (demo only, not production banking)
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
SETU_BASE_URL=https://api.setu.co
SETU_ENVIRONMENT=sandbox
# When true, the AA sandbox falls back to deterministic demo data when Setu
# credentials are absent or the sandbox is unreachable.
AA_ALLOW_DEMO_FALLBACK=true

# When true, ML pipeline falls back to keyword matching if the model is missing
ML_ALLOW_FALLBACK=false

# Upload storage (local by default; set SUPABASE_URL + SUPABASE_SERVICE_KEY for production)
UPLOAD_DIR=uploads/receipts
SUPABASE_URL=
SUPABASE_SERVICE_KEY=