# Local development. Real environment variables (Vercel/Render) take precedence.
# Leave API_BASE_URL unset to use the webpack dev-server proxy (targets the backend on :8080).
# For a deployed build, set API_BASE_URL to the backend origin (e.g. https://intellimoney-api.onrender.com/api/v1).
# API_BASE_URL=

# Clerk publishable key (pk_test_... / pk_live_...) — required for Clerk-based sign-in
VITE_CLERK_PUBLISHABLE_KEY=

# WebSocket host for live dashboard updates (optional)
# VITE_WS_HOST=
